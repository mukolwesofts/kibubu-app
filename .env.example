# Turso (libSQL) database — https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Kibubu <kibubu@yourdomain.com>

# Random 32+ char secret used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Random secret sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
